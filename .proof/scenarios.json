{
  "repository": "brunnojob/industrial-iot-sentinel",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.py",
    "sentinel.py",
    "events.py",
    "test_validation.py",
    "test_journal.py",
    "test_cli.py",
    "examples/vessel.json",
    "examples/movements.jsonl",
    "test_concurrency.py"
  ],
  "cases": [
    {
      "name": "Process documented JSONL input as one transaction",
      "argv": [
        "python",
        "events.py",
        "examples/vessel.json",
        "--database",
        ":memory:",
        "--atomic-batch"
      ],
      "input": "examples/movements.jsonl",
      "contains": [
        "\"events\": 3",
        "\"peopleOnBoard\": 1"
      ],
      "timeout": 30
    },
    {
      "name": "python -m unittest discover -v",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "python -m unittest discover -v -s cloud",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "python -m unittest discover -v -s cloud"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Persist occupancy, reject overflow, recover and replay",
      "argv": [
        "python",
        ".proof/demo.py"
      ],
      "contains": [
        "\"capacity_rejection_atomic\": true",
        "\"replay_idempotent\": true"
      ],
      "timeout": 120
    }
  ]
}
